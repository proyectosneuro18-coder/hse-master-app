# ── Supabase (nomenclatura nueva: publishable/secret) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxx

# ── Email transaccional (Resend) ────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=hola@tudominio.com

# ── Venta (Hotmart) ──────────────────────────────────────────────────────────
HOTMART_HOTTOK=
HOTMART_PRODUCT_ID=

# ── Medición (PostHog) — ver lib/analytics.ts y docs/sistema/36 ───────────────
# La project key (phc_...) es PÚBLICA por diseño (va en el navegador). Sin ella, no se mide nada.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Opcionales, SOLO servidor: permiten borrar las mediciones al eliminar una cuenta.
# La personal API key es SECRETA (nunca con prefijo NEXT_PUBLIC_).
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
